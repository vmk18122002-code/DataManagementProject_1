PORT=4000
# portal origin allowed by CORS
PORTAL_ORIGIN=http://localhost:3000,http://localhost:3001
# SQLite file (swap the DbService for PostgreSQL in production)
DB_FILE=data/reliefhub.db
# minutes between automatic fetches
FETCH_EVERY_MIN=15
# ReliefWeb: empty = public RSS feeds (no registration). Set an APPROVED appname to use API v2 instead:
# https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
# key that external workers (DMC PDF worker, scrapers) send in the x-api-key header to POST /raw-items
INGEST_API_KEY=change-me

# MongoDB: accounts (donors, organization members) and donor data (profiles, donations)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=reliefhub
# signs the login tokens, at least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# first organization admin, created on startup while no organization account exists
ORG_ADMIN_EMAIL=admin@reliefhub.lk
ORG_ADMIN_PASSWORD=

# need model: folder with predict.py and models/, and the Python that has pandas, xgboost and joblib
MODEL_PROJECT_DIR=..
PYTHON=python

# portal address used in emails
PORTAL_URL=http://localhost:3000
# outgoing email (collector invitations). Leave SMTP_HOST empty to send nothing: the admin is then shown the
# temporary password to pass on. Gmail: smtp.gmail.com, port 587, your address, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ReliefHub <no-reply@example.com>
# hours a temporary password (collector invitation, forgot password) stays valid
TEMP_PASSWORD_HOURS=48
